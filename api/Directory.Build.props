<Project>

  <!--
    Settings shared by every project under api/. Keeping them here means a new project
    cannot accidentally opt out of nullable reference types or of warnings-as-errors.

    Deliberately free of <PackageReference>: DevHub.Domain must have zero NuGet
    dependencies (DEVHUB-002 acceptance criteria), and anything added here would
    silently land in Domain too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- .NET analyzers are on by default for net5.0+ SDK-style projects (EnableNETAnalyzers).
         This also enforces the .editorconfig style rules at build time, so a plain
         `dotnet build` catches what `dotnet format` would flag. No NuGet package needed,
         so DevHub.Domain stays dependency-free. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
