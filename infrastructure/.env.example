# ---------------------------------------------------------------------------
# Optional per-machine overrides for infrastructure/docker-compose.yml.
#
#   cp infrastructure/.env.example infrastructure/.env
#
# You almost certainly do not need this file. Compose reads `.env` from the
# directory of the compose file, and every value below already has a working
# default, so a fresh clone runs `docker compose up -d` with no setup at all.
#
# `.env` is git-ignored: these are per-machine conveniences, never shared
# configuration, and never secrets. The database credentials are intentionally
# NOT here — they are hardcoded as devhub/devhub in the compose file so that a
# fresh clone has nothing to fill in.
# ---------------------------------------------------------------------------

# Host port for PostgreSQL. Override only if something else already owns 5432 —
# another project's container, or a Postgres installed on the host. Check with:
#   ss -ltnp | grep 5432          (Linux)
#   lsof -i :5432                 (macOS)
#
# If you change this, the API connection string has to match:
#   dotnet user-secrets set "ConnectionStrings:Default" \
#     "Host=localhost;Port=5433;Database=devhub;Username=devhub;Password=devhub"
#POSTGRES_PORT=5432

# Host port for Adminer. Override if 5050 is taken.
#ADMINER_PORT=5050
