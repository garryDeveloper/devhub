# Copy to .env.local (git-ignored) and adjust per machine — see docs/tech-specs/local-development.md §6.
# On a physical device, localhost is the phone, not your computer: use the machine's LAN IP
# (ipconfig getifaddr en0 on macOS, hostname -I on Linux) and make sure the API listens on 0.0.0.0.
EXPO_PUBLIC_API_URL=http://localhost:5080
