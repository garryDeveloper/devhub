# ---------------------------------------------------------------------------
# DevHub — root .gitignore
# Nothing that a build, a tool or a machine produces belongs in git history.
# ---------------------------------------------------------------------------

# --- .NET / C# -------------------------------------------------------------
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.dbmdl
.vs/
TestResults/
[Cc]overage*/
*.coverage
*.trx
BenchmarkDotNet.Artifacts/
# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
!packages/build/
# Publish output
publish/
[Pp]ublish[Pp]rofiles/*.user

# --- Node / React / React Native -------------------------------------------
node_modules/
dist/
build/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo
.eslintcache
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & secrets --------------------------------------------------
# Real values never enter the repository; only the example templates do.
.env
.env.*
!.env.example
*.pfx
*.p12
secrets.json
appsettings.Local.json

# --- Operating system -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editors & IDEs ---------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# --- Local infrastructure ---------------------------------------------------
# Docker volumes are named volumes; nothing should land here, but just in case.
infrastructure/**/data/
